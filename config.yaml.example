# Example configuration for poc-util.
# Copy to config.yaml and fill in your values.

jfrog:
  base_url: "https://your-instance.jfrog.io"
  token: "your-jfrog-token"
  # Optional: use for webhook header; defaults to token
  # platform_token: "your-platform-token"

init:
  worker:
    key: "sbom-service"
  webhook:
    name: "scanCompleted"
    url: "http://jfrog-platform-artifactory-nginx/worker/api/v1/execute/sbom-service"
  policy:
    name: "sbom-policy"
    type: "security"
  watch:
    name: "poc-watch"
    assigned_policies:
      - name: "sbom-policy"
        type: "security"

sync:
  source_server_id: "source-server"  # jf config; pattern search uses jf rt curl with this server
  source_patterns:
    - "repo-name:*pattern*.whl"
    - "other-repo:path/*.tgz"
  target_server_id: "target-server"
  target_repo: "target-repo"
  target_path: ""  # optional
  download_dir: "./sync_download"  # optional
